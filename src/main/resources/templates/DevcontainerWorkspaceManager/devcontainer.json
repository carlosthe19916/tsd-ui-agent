\{
{#if image}
  "image": "{image}",
{/if}
  "remoteUser": "{remoteUser}",
  "workspaceFolder": "{workspaceFolder}",
{#if featuresJson}
  "features": {featuresJson},
{/if}
{#if vscodeExtensions}
  "customizations": \{
    "vscode": \{
      "extensions": [
{#for ext in vscodeExtensions}
        "{ext}"{#if !ext_isLast},{/if}
{/for}
      ]
    \}
  \},
{/if}
  "containerEnv": \{
{#for env in envVars}
    "{env.name}": "{env.value}"{#if !env_isLast},{/if}
{/for}
  \},
{#if mounts}
  "mounts": [
{#for mount in mounts}
    "{mount}"{#if !mount_isLast},{/if}
{/for}
  ],
{/if}
  "postCreateCommand": "{postCreateCommand}"{#if postStartCommand},
  "postStartCommand": "{postStartCommand}",
  "waitFor": "postStartCommand"{/if}{#if appPort},
  "appPort": [{#for port in appPort}{port}{#if !port_isLast}, {/if}{/for}]{/if}
\}
